  150.6061, 156.7911, 173.8756, 199.9593, 233.3053, 271.9389, 313.2565, 353.7712, 389.0758, 414.0729, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000;

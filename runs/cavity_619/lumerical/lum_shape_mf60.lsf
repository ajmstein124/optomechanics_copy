  112.2551, 120.2788, 141.6756, 172.9658, 211.6342, 255.4421, 301.6552, 346.6048, 385.5923, 413.1274, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000;
  112.2551, 120.2788, 141.6756, 172.9658, 211.6342, 255.4421, 301.6552, 346.6048, 385.5923, 413.1274, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000;
  94.2943, 101.5730, 121.3650, 151.2690, 189.6920, 235.0068, 284.6660, 334.6261, 379.1760, 411.2766, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000;
  94.2943, 101.5730, 121.3650, 151.2690, 189.6920, 235.0068, 284.6660, 334.6261, 379.1760, 411.2766, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000;
  94.2943, 101.5730, 121.3650, 151.2690, 189.6920, 235.0068, 284.6660, 334.6261, 379.1760, 411.2766, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000;
  73.0401, 81.9134, 104.8872, 137.9586, 179.1921, 227.0381, 279.0310, 331.1125, 377.4516, 410.8051, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000;
  73.0401, 81.9134, 104.8872, 137.9586, 179.1921, 227.0381, 279.0310, 331.1125, 377.4516, 410.8051, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000;
  73.0401, 81.9134, 104.8872, 137.9586, 179.1921, 227.0381, 279.0310, 331.1125, 377.4516, 410.8051, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000;
  61.3537, 69.1743, 89.8506, 120.6531, 160.6134, 208.8750, 263.3160, 319.6693, 371.1708, 408.9647, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000, 423.5000];
XEND = [4744.0000;
  4904.0000;

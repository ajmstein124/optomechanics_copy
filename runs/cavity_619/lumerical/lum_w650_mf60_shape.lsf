  282.6228, 287.9191, 302.5053, 324.5788, 352.3450, 383.8132, 416.6421, 448.0551, 474.8501, 493.5204, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000;

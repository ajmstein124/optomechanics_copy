  257.9982, 264.0343, 280.5888, 305.4803, 336.5820, 371.6255, 408.0182, 442.7268, 472.2667, 492.8212, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000, 500.5000;
